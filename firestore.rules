rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Replace with your admin checks or emails
      return isSignedIn() && 
      (request.auth.token.email == "admin@example.com" || request.auth.token.email == "prajapatidev9974@gmail.com"); 
    }
    
    match /bookings/{bookingId} {
      // Anyone can create? Only if using client-side creation. Adjust as necessary.
      allow create: if true; 
      allow read: if isAdmin() || (isSignedIn() && resource.data.mobile == request.auth.token.phone_number);
      allow update, delete: if isAdmin();
    }
  }
}
